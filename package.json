{
  "name": "cameyo-backend",
  "version": "1.1.0",
  "description": "Backend API para CameYo - Plataforma conecta técnicos verificados con clientes en municipios de Colombia. Implementa multi-tenancy, autenticación JWT, pagos integrados y verificación de identidad.",
  "author": {
    "name": "IETI 2026 Team",
    "url": "https://github.com/IETI-2026|"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/IETI-2026/backend.git"
  },
  "homepage": "https://github.com/IETI-2026/backend#readme",
  "bugs": {
    "url": "https://github.com/IETI-2026/backend/issues"
  },
  "keywords": [
    "nestjs",
    "typescript",
    "multi-tenancy",
    "jwt-auth",
    "postgresql",
    "typeorm",
    "rest-api",
    "cloud-services",
    "cameyo"
  ],
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build && npm run build:copy-assets",
    "build:copy-assets": "copyfiles -u 0 src/modules/mail/infrastructure/templates/*.hbs dist/",
    "format": "biome format --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:staged": "jest --bail --findRelatedTests",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "validate": "npm run type-check && npm run lint && npm run test",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "docs:generate": "nest build && ts-node -p tsconfig.build.json src/docs/generate-swagger.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "db:drop": "ts-node -r tsconfig-paths/register src/database/drop.ts",
    "db:create": "ts-node -r tsconfig-paths/register src/database/create.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend",
    "docker:restart": "docker-compose restart backend",
    "docker:clean": "docker-compose down -v",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f backend-dev",
    "docker:dev:clean": "docker-compose -f docker-compose.dev.yml down -v",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "nodemailer": "^8.0.2",
    "openai": "^6.22.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@jest/globals": "^30.0.0-alpha.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.2.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "copyfiles": "^2.4.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched",
      "npm run test:staged --"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
