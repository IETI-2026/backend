# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/cameyo

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback
FRONTEND_URL=https://yourdomain.com

# Pagos ePayco
EPAYCO_P_CUST_ID=your-epayco-customer-id
EPAYCO_P_KEY=your-epayco-private-key

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Correo SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com

# Azure Storage
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
STORAGE_CONTAINER_NAME=cameyo-storage

# CORS
CORS_ORIGINS=http://localhost:3000

# Azure AI Agent
AGENT_ENDPOINT=https://your-agent-endpoint
AGENT_API_KEY=your-agent-key
AGENT_API_VERSION=2024-05-01-preview

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_FULLNAME=Admin
ADMIN_PHONE=+573000000000

# App
NODE_ENV=development
PORT=3000
